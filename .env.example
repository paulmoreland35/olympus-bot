# TradeLocker Credentials
TL_BASE_URL=https://members.livvfxtrading.com/backend-api
TL_EMAIL=your@email.com
TL_PASSWORD=your_password
TL_SERVER=LIVVFX

# Risk Settings
RISK_PCT=0.02         # 2% risk per trade
DEFAULT_SL_PCT=0.01   # 1% fallback SL if none in alert

# Webhook Security Token (match this in TradingView alert message)
WEBHOOK_SECRET=choose_a_random_secret_string

# Port (Railway sets automatically)
PORT=5000

# Autonomous Scanner (get free key at https://twelvedata.com)
TWELVE_DATA_API_KEY=your_key_here
# Comma-separated: TD_symbol:broker_symbol or just TD_symbol
# SCANNER_SYMBOLS=XAU/USD:XAUUSD,NDX:NAS100,DJI:DJIUSD
