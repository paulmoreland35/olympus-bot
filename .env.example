# TradeLocker Credentials
TL_BASE_URL=https://members.livvfxtrading.com/backend-api
TL_EMAIL=your@email.com
TL_PASSWORD=your_password
TL_SERVER=LIVVFX

# Risk Settings
RISK_PCT=0.02         # 2% risk per trade
DEFAULT_SL_PCT=0.01   # 1% fallback SL if none in alert (used unless DEFAULT_SL_POINTS is set)

# Fixed-point SL/TP fallback — for signals with no SL/TP of their own (e.g.
# Phoenix's "SELL Signal on TICKER at PRICE"). Only makes sense for
# point-based instruments (indices) — leave unset on deployments also
# trading forex/metals, where DEFAULT_SL_PCT/DEFAULT_TP_RR apply instead.
# DEFAULT_SL_POINTS=30
# DEFAULT_TP_POINTS=40

# Webhook Security Token (match this in TradingView alert message)
WEBHOOK_SECRET=choose_a_random_secret_string

# Mirror/forward — relay every accepted signal to other accounts' bots so
# they trade the same alerts (each sized to its own balance). Each account
# is its own separate deployment of this repo. Leave blank if you only run
# one account. Numbered _2, _3, ... for additional accounts beyond the first.
# FORWARD_TO_URL=https://partner-bot.up.railway.app/webhook
# FORWARD_TO_SECRET=partner_bots_webhook_secret
# FORWARD_TO_LABEL=partner
# FORWARD_TO_URL_2=https://account2-bot.up.railway.app/webhook
# FORWARD_TO_SECRET_2=account2_webhook_secret
# FORWARD_TO_LABEL_2=account2
# FORWARD_TO_URL_3=https://account3-bot.up.railway.app/webhook
# FORWARD_TO_SECRET_3=account3_webhook_secret
# FORWARD_TO_LABEL_3=account3

# Port (Railway sets automatically)
PORT=5000

# Autonomous Scanner (get free key at https://twelvedata.com)
TWELVE_DATA_API_KEY=your_key_here
# Comma-separated: TD_symbol:broker_symbol or just TD_symbol
# SCANNER_SYMBOLS=XAU/USD:XAUUSD,NDX:NAS100,DJI:DJIUSD

# Daily Report (set on whichever bot should send the email)
# RESEND_API_KEY=your_resend_api_key
# REPORT_TO=you@email.com
# REPORT_SOURCES=Label1=https://bot1.up.railway.app/report,Label2=https://bot2.up.railway.app/report

# AI Trading Coach — optional. Set to add a "Coach's Notes" section to the
# daily report email, written by Claude analyzing the day's actual trades
# and account stats. Leave unset to skip it entirely (report still sends
# fine without it). Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=your_anthropic_api_key
