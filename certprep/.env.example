# Required in production: long random string, keeps users signed in across restarts/workers
SECRET_KEY=change-me
SITE_NAME=CertPrep
# Set to 1 behind HTTPS
SESSION_COOKIE_SECURE=1
# Where the SQLite database lives (put it on a persistent volume in production)
DATABASE_PATH=/data/certprep.db

# Local testing only: enables a "toggle premium" button so you can test paid features without Stripe
DEV_MODE=0

# Stripe billing (optional until you're ready to charge)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
PRICE_MONTHLY_DISPLAY=$19/month
PRICE_ANNUAL_DISPLAY=$99/year

# Question generator (tools/generate_questions.py)
ANTHROPIC_API_KEY=
