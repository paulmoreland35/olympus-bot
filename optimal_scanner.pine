//@version=6
// 1HOUSE Optimal Scanner [Moreland]
// Recreation of the XAUUSD "Optimal Sell / Optimal Buy" scanner.
// Signal = confirmed swing pivot + EMA cloud alignment.
// SL = swing point (or ATR). Entry = confirmation close. TP1/2/3 = R multiples.
// Pine v6 notes: no multi-line ternaries, no Unicode in strings, const alert messages.

indicator("1HOUSE Optimal Scanner [Moreland]", shorttitle="Optimal Scanner", overlay=true,
     max_lines_count=500, max_labels_count=500)

// ============================================================ INPUTS
grpS     = "Signal Engine"
leftB    = input.int(5, "Pivot Left Bars", minval=1, group=grpS)
rightB   = input.int(2, "Pivot Right Bars (confirmation)", minval=1, group=grpS)
useEma   = input.bool(true, "Require EMA Cloud Alignment", group=grpS)
fastL    = input.int(9, "Fast EMA", minval=1, group=grpS)
slowL    = input.int(21, "Slow EMA", minval=1, group=grpS)
showSell = input.bool(true, "Show Optimal Sell", group=grpS)
showBuy  = input.bool(true, "Show Optimal Buy", group=grpS)
oneTrade = input.bool(true, "One Trade At A Time", group=grpS)

grpR     = "Risk / Targets"
slMode   = input.string("Swing", "Stop Loss Mode", options=["Swing", "ATR"], group=grpR)
slBuf    = input.float(0.0, "Swing SL Buffer (price)", step=0.1, group=grpR)
atrLen   = input.int(14, "ATR Length", minval=1, group=grpR)
atrMult  = input.float(1.5, "ATR SL Multiplier", step=0.1, group=grpR)
minRisk  = input.float(2.0, "Minimum Risk (price units)", step=0.1, group=grpR)
tp1R     = input.float(1.0, "TP 1 (R)", step=0.1, group=grpR)
tp2R     = input.float(2.0, "TP 2 (R)", step=0.1, group=grpR)
tp3R     = input.float(3.0, "TP 3 (R)", step=0.1, group=grpR)
closeSL  = input.bool(true, "Close Trade On Stop Loss", group=grpR)
showHits = input.bool(true, "Show TP / SL Hit Markers", group=grpR)

grpV     = "Visuals"
showCloud = input.bool(true, "Show EMA Cloud", group=grpV)
cloudUp   = input.color(color.new(#b7c4c7, 55), "Cloud Bull", group=grpV)
cloudDn   = input.color(color.new(#d9c9a6, 55), "Cloud Bear", group=grpV)
sellCol   = input.color(#ef5350, "Sell / Stop Loss", group=grpV)
buyCol    = input.color(#26a69a, "Buy", group=grpV)
entryCol  = input.color(#2962ff, "Entry", group=grpV)
tpCol     = input.color(#4caf50, "Take Profit", group=grpV)
lineW     = input.int(2, "Line Width", minval=1, maxval=4, group=grpV)
lblSizeIn = input.string("normal", "Label Size", options=["tiny", "small", "normal", "large"], group=grpV)

grpX     = "Sessions"
showSess = input.bool(true, "Session Backgrounds", group=grpX)
showSR   = input.bool(true, "Session High / Low / Mid Lines", group=grpX)
sessTZ   = input.string("America/New_York", "Session Timezone", group=grpX)
asiaS    = input.session("2000-0300", "Asia", group=grpX)
lonS     = input.session("0300-0930", "London", group=grpX)
nyS      = input.session("0930-1700", "New York", group=grpX)
asiaBg   = input.color(color.new(#8e9ecf, 82), "Asia Color", group=grpX)
lonBg    = input.color(color.new(#f0b35a, 70), "London Color", group=grpX)
nyBg     = input.color(color.new(#4db6ac, 70), "New York Color", group=grpX)

// ============================================================ HELPERS (script scope)
fmt(float p) =>
    str.tostring(p, "#.##")

lblSizeF(string s) =>
    string r = size.normal
    if s == "tiny"
        r := size.tiny
    else if s == "small"
        r := size.small
    else if s == "large"
        r := size.large
    r

inSessF(string sess) =>
    not na(time(timeframe.period, sess, sessTZ))

sessColF(int id) =>
    color c = color.gray
    if id == 1
        c := color.new(asiaBg, 0)
    else if id == 2
        c := color.new(lonBg, 0)
    else if id == 3
        c := color.new(nyBg, 0)
    c

lblSize = lblSizeF(lblSizeIn)

// ============================================================ CORE CALCS
emaF = ta.ema(close, fastL)
emaS = ta.ema(close, slowL)
atr  = ta.atr(atrLen)
ph   = ta.pivothigh(high, leftB, rightB)
pl   = ta.pivotlow(low, leftB, rightB)

// ============================================================ EMA CLOUD
pF = plot(showCloud ? emaF : na, "Fast EMA", color=color.new(color.gray, 70), linewidth=1)
pS = plot(showCloud ? emaS : na, "Slow EMA", color=color.new(color.gray, 70), linewidth=1)
color cloudC = na
if showCloud
    if emaF > emaS
        cloudC := cloudUp
    else
        cloudC := cloudDn
fill(pF, pS, color=cloudC, title="EMA Cloud")

// ============================================================ SESSIONS
inAsia = inSessF(asiaS)
inLon  = inSessF(lonS)
inNy   = inSessF(nyS)

int sessId = 0
if inAsia
    sessId := 1
else if inLon
    sessId := 2
else if inNy
    sessId := 3

color bgc = na
if showSess
    if sessId == 1
        bgc := asiaBg
    else if sessId == 2
        bgc := lonBg
    else if sessId == 3
        bgc := nyBg
bgcolor(bgc, title="Session Background")

var float sHi   = na
var float sLo   = na
var line  sHiL  = na
var line  sLoL  = na
var line  sMidL = na

newSess = sessId != 0 and sessId != sessId[1]
if showSR
    if newSess
        sHi := high
        sLo := low
        color sc = sessColF(sessId)
        sHiL  := line.new(bar_index, high, bar_index, high, color=sc, style=line.style_dashed, width=1)
        sLoL  := line.new(bar_index, low, bar_index, low, color=sc, style=line.style_dashed, width=1)
        sMidL := line.new(bar_index, (high + low) / 2, bar_index, (high + low) / 2, color=sc, style=line.style_dotted, width=1)
    else if sessId != 0 and not na(sHiL)
        sHi := math.max(sHi, high)
        sLo := math.min(sLo, low)
        float mid = (sHi + sLo) / 2
        line.set_y1(sHiL, sHi)
        line.set_y2(sHiL, sHi)
        line.set_x2(sHiL, bar_index)
        line.set_y1(sLoL, sLo)
        line.set_y2(sLoL, sLo)
        line.set_x2(sLoL, bar_index)
        line.set_y1(sMidL, mid)
        line.set_y2(sMidL, mid)
        line.set_x2(sMidL, bar_index)

// ============================================================ TRADE STATE
var int   tDir   = 0
var float tEntry = na
var float tSL    = na
var float tTP1   = na
var float tTP2   = na
var float tTP3   = na
var int   tBar   = na
var bool  hit1   = false
var bool  hit2   = false
var bool  hit3   = false

var line  lS = na
var line  lE = na
var line  l1 = na
var line  l2 = na
var line  l3 = na
var label bS = na
var label bE = na
var label b1 = na
var label b2 = na
var label b3 = na

// alert flags (script scope, reset each bar)
bool aTp1 = false
bool aTp2 = false
bool aTp3 = false
bool aSL  = false

// dynamic alert-message holders (script scope, reset each bar; filled at the
// moment each event fires, before anything later this bar can move tSL/tTP*)
// Format mirrors the native Olympus alert this bot's parser.py expects:
//   BUY GBPUSD | 1 | 01:19 | ENTRY: 1.359 | SL: 1.355 | TP1: 1.363 | TP2: 1.366 | TP3: 1.379 | R:R 1:1
barTime = str.format_time(time, "HH:mm")
string msgTp1 = ""
string msgTp2 = ""
string msgTp3 = ""
string msgSL  = ""
string sigMsg = ""

// ============================================================ MANAGE OPEN TRADE
if tDir != 0 and bar_index > tBar
    line.set_x2(lS, bar_index)
    line.set_x2(lE, bar_index)
    line.set_x2(l1, bar_index)
    line.set_x2(l2, bar_index)
    line.set_x2(l3, bar_index)
    label.set_x(bS, bar_index)
    label.set_x(bE, bar_index)
    label.set_x(b1, bar_index)
    label.set_x(b2, bar_index)
    label.set_x(b3, bar_index)

    bool stopped = false
    if tDir == -1
        if not hit1 and low <= tTP1
            hit1 := true
            aTp1 := true
            msgTp1 := " TP1 HIT " + syminfo.ticker + " | " + timeframe.period + " | " + barTime + " | PRICE: " + fmt(tTP1)
        if not hit2 and low <= tTP2
            hit2 := true
            aTp2 := true
            msgTp2 := " TP2 HIT " + syminfo.ticker + " | " + timeframe.period + " | " + barTime + " | PRICE: " + fmt(tTP2)
        if not hit3 and low <= tTP3
            hit3 := true
            aTp3 := true
            msgTp3 := " TP3 HIT " + syminfo.ticker + " | " + timeframe.period + " | " + barTime + " | PRICE: " + fmt(tTP3)
        if closeSL and high >= tSL
            stopped := true
            aSL := true
            msgSL := " STOP LOSS HIT " + syminfo.ticker + " | " + timeframe.period + " | " + barTime + " | PRICE: " + fmt(tSL)
    else
        if not hit1 and high >= tTP1
            hit1 := true
            aTp1 := true
            msgTp1 := " TP1 HIT " + syminfo.ticker + " | " + timeframe.period + " | " + barTime + " | PRICE: " + fmt(tTP1)
        if not hit2 and high >= tTP2
            hit2 := true
            aTp2 := true
            msgTp2 := " TP2 HIT " + syminfo.ticker + " | " + timeframe.period + " | " + barTime + " | PRICE: " + fmt(tTP2)
        if not hit3 and high >= tTP3
            hit3 := true
            aTp3 := true
            msgTp3 := " TP3 HIT " + syminfo.ticker + " | " + timeframe.period + " | " + barTime + " | PRICE: " + fmt(tTP3)
        if closeSL and low <= tSL
            stopped := true
            aSL := true
            msgSL := " STOP LOSS HIT " + syminfo.ticker + " | " + timeframe.period + " | " + barTime + " | PRICE: " + fmt(tSL)

    if showHits
        if aTp1
            if tDir == -1
                label.new(bar_index, tTP1, "TP1", style=label.style_label_up, color=tpCol, textcolor=color.white, size=size.tiny)
            else
                label.new(bar_index, tTP1, "TP1", style=label.style_label_down, color=tpCol, textcolor=color.white, size=size.tiny)
        if aTp2
            if tDir == -1
                label.new(bar_index, tTP2, "TP2", style=label.style_label_up, color=tpCol, textcolor=color.white, size=size.tiny)
            else
                label.new(bar_index, tTP2, "TP2", style=label.style_label_down, color=tpCol, textcolor=color.white, size=size.tiny)
        if aTp3
            if tDir == -1
                label.new(bar_index, tTP3, "TP3", style=label.style_label_up, color=tpCol, textcolor=color.white, size=size.tiny)
            else
                label.new(bar_index, tTP3, "TP3", style=label.style_label_down, color=tpCol, textcolor=color.white, size=size.tiny)
        if aSL
            if tDir == -1
                label.new(bar_index, tSL, "SL", style=label.style_label_down, color=sellCol, textcolor=color.white, size=size.tiny)
            else
                label.new(bar_index, tSL, "SL", style=label.style_label_up, color=sellCol, textcolor=color.white, size=size.tiny)

    if hit3 or stopped
        tDir := 0

// ============================================================ SIGNALS
canOpen = not oneTrade or tDir == 0
bearOk  = not useEma or (close < emaF and emaF < emaS)
bullOk  = not useEma or (close > emaF and emaF > emaS)

sellSig = showSell and not na(ph) and bearOk and canOpen
buySig  = showBuy and not na(pl) and bullOk and canOpen

int newDir = 0
if sellSig
    newDir := -1
else if buySig
    newDir := 1

// ============================================================ OPEN TRADE
if newDir != 0
    float pivotPx  = newDir == -1 ? ph : pl
    int   pivotBar = bar_index - rightB
    float entryPx  = close
    float slPx     = na
    if slMode == "Swing"
        slPx := pivotPx - newDir * slBuf
    else
        slPx := entryPx - newDir * atr * atrMult

    float risk = math.abs(slPx - entryPx)
    if risk < minRisk
        risk := minRisk
        slPx := entryPx - newDir * risk

    tDir   := newDir
    tEntry := entryPx
    tSL    := slPx
    tTP1   := entryPx + newDir * risk * tp1R
    tTP2   := entryPx + newDir * risk * tp2R
    tTP3   := entryPx + newDir * risk * tp3R
    tBar   := bar_index
    hit1   := false
    hit2   := false
    hit3   := false

    string dirWord = newDir == -1 ? "SELL" : "BUY"
    string rrTxt   = str.tostring(tp1R, "#.##")
    sigMsg := " " + dirWord + " " + syminfo.ticker + " | " + timeframe.period + " | " + barTime + " | ENTRY: " + fmt(tEntry) + " | SL: " + fmt(tSL) + " | TP1: " + fmt(tTP1) + " | TP2: " + fmt(tTP2) + " | TP3: " + fmt(tTP3) + " | R:R 1:" + rrTxt

    // signal label at the swing point
    if newDir == -1
        label.new(pivotBar, pivotPx, "Optimal Sell", style=label.style_label_down, color=sellCol, textcolor=color.white, size=lblSize)
    else
        label.new(pivotBar, pivotPx, "Optimal Buy", style=label.style_label_up, color=buyCol, textcolor=color.white, size=lblSize)

    // level lines
    lS := line.new(pivotBar, tSL, bar_index, tSL, color=sellCol, width=lineW)
    lE := line.new(bar_index, tEntry, bar_index, tEntry, color=entryCol, width=lineW)
    l1 := line.new(pivotBar, tTP1, bar_index, tTP1, color=tpCol, width=lineW)
    l2 := line.new(pivotBar, tTP2, bar_index, tTP2, color=tpCol, width=lineW)
    l3 := line.new(pivotBar, tTP3, bar_index, tTP3, color=tpCol, width=lineW)

    // price tags (follow the current bar)
    bS := label.new(bar_index, tSL, "Stop Loss: " + fmt(tSL), style=label.style_label_left, color=sellCol, textcolor=color.white, size=lblSize)
    bE := label.new(bar_index, tEntry, "Entry: " + fmt(tEntry), style=label.style_label_left, color=entryCol, textcolor=color.white, size=lblSize)
    b1 := label.new(bar_index, tTP1, "TP 1: " + fmt(tTP1), style=label.style_label_left, color=tpCol, textcolor=color.white, size=lblSize)
    b2 := label.new(bar_index, tTP2, "TP 2: " + fmt(tTP2), style=label.style_label_left, color=tpCol, textcolor=color.white, size=lblSize)
    b3 := label.new(bar_index, tTP3, "TP 3: " + fmt(tTP3), style=label.style_label_left, color=tpCol, textcolor=color.white, size=lblSize)

// ============================================================ ALERTS (const messages)
alertcondition(sellSig, "Optimal Sell", "Optimal Sell signal - Optimal Scanner")
alertcondition(buySig,  "Optimal Buy",  "Optimal Buy signal - Optimal Scanner")
alertcondition(aTp1,    "TP 1 Hit",     "TP 1 hit - Optimal Scanner")
alertcondition(aTp2,    "TP 2 Hit",     "TP 2 hit - Optimal Scanner")
alertcondition(aTp3,    "TP 3 Hit",     "TP 3 hit - Optimal Scanner")
alertcondition(aSL,     "Stop Loss Hit","Stop loss hit - Optimal Scanner")

// ============================================================ ALERTS (dynamic - bot webhook)
// alertcondition() messages above are compile-time constants, so they can't
// carry live entry/SL/TP prices. These alert() calls fire the same six
// events with the live values baked in, matching TradingView's "Any alert()
// function call" trigger (see README "Set up TradingView alerts") and the
// native Olympus format this bot's parser.py expects, e.g.:
//   BUY GBPUSD | 1 | 01:19 | ENTRY: 1.359 | SL: 1.355 | TP1: 1.363 | TP2: 1.366 | TP3: 1.379 | R:R 1:1
if newDir != 0
    alert(sigMsg, alert.freq_once_per_bar_close)

if aTp1
    alert(msgTp1, alert.freq_once_per_bar_close)

if aTp2
    alert(msgTp2, alert.freq_once_per_bar_close)

if aTp3
    alert(msgTp3, alert.freq_once_per_bar_close)

if aSL
    alert(msgSL, alert.freq_once_per_bar_close)
